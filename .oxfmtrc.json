{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 100,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"ignorePatterns": [
		"dist",
		".output",
		".tanstack",
		"public",
		"src/routeTree.gen.ts",
		"bun.lock",
		"portfolio.sublime-project",
		"portfolio.sublime-workspace",
		"assets"
	]
}
